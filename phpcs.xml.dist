<?xml version="1.0"?>
<ruleset name="Twinspot Lite">
	<file>twinspot-lite.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress">
		<!-- PSR-4 style autoloading (includes/<Sub>/<Class>.php) is deliberate. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Docblock completeness is not a WordPress.org requirement. -->
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.4"/>
	<rule ref="WordPress.WP.Capabilities">
		<properties><property name="custom_capabilities" type="array"><element value="manage_woocommerce"/><element value="edit_shop_orders"/></property></properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="twinspot-lite"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="twinspot_lite"/><element value="Twinspot_Lite"/></property></properties>
	</rule>
</ruleset>
